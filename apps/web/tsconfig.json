{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "preserve",
        "incremental": true,
        "rootDir": ".",
        "lib": ["dom", "dom.iterable", "esnext"],
        "paths": {
            "@/*": ["./src/*"]
        },
        "allowJs": true,
        "noEmit": true,
        "plugins": [
            {
                "name": "next"
            }
        ]
    },
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
